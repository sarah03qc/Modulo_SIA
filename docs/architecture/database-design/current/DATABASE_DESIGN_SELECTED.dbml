//// SIA-CENCINAI — modelo logico de la base propia.
//// No es DDL. No incluye tablas de SIDINACC ni de SIDINACC_LOCAL.
//// Los identificadores institucionales se guardan sin llave foranea externa.

Project sia_cencinai {
  database_type: 'SQL Server'
  Note: 'Arquitectura logica seleccionada. Hechos operativos, historia selectiva y cadena de episodios territoriales.'
}

Table referencia {
  referencia_id bigint [pk, increment]
  persona_institucional_id nvarchar [not null, note: 'PER_idPersona. Sin FK a SIDINACC']
  fecha_referencia date [not null]
  estado nvarchar [not null, note: 'PENDIENTE_REVISION, ADMITIDA, NO_REQUIERE_AI']
  via_atencion_item_id bigint [not null]
  origen_item_id bigint [not null]
  acciones_previas nvarchar
  resultados_previos nvarchar
  informacion_complementaria nvarchar
  consecutivo nvarchar [not null, unique]
  anio_consecutivo int [not null]
  secuencia_consecutivo int [not null]
  region_id int [not null]
  region_codigo_snapshot nvarchar [not null]
  region_nombre_snapshot nvarchar [not null]
  oficina_local_id int [not null]
  oficina_local_codigo_snapshot nvarchar [not null]
  oficina_local_nombre_snapshot nvarchar [not null]
  establecimiento_id int [not null]
  establecimiento_codigo_snapshot nvarchar [not null]
  establecimiento_nombre_snapshot nvarchar [not null]
  nombre_snapshot nvarchar [not null]
  fecha_nacimiento_snapshot date
  sexo_codigo_snapshot nvarchar
  sexo_descripcion_snapshot nvarchar
  edad_anios_snapshot int
  encargada_nombre_snapshot nvarchar
  encargada_relacion_snapshot nvarchar
  contacto_snapshot nvarchar
  direccion_snapshot nvarchar
  fuente_codigo nvarchar [not null, note: 'SIDINACC']
  responsable_actor_id nvarchar [not null]
  responsable_nombre_snapshot nvarchar [not null]
  remitente_actor_id nvarchar [not null]
  enviada_en datetime2 [not null]
  lote_migracion_id bigint
  version_fila rowversion
  indexes {
    (oficina_local_id, estado, enviada_en)
    (establecimiento_id, estado)
    (persona_institucional_id, enviada_en)
  }
}

Table referencia_motivo {
  referencia_motivo_id bigint [pk, increment]
  referencia_id bigint [not null]
  item_id bigint [not null]
  etiqueta_snapshot nvarchar [not null]
  especificacion nvarchar
  indexes {
    (referencia_id, item_id) [unique]
  }
}

Table referencia_servicio_snapshot {
  referencia_servicio_id bigint [pk, increment]
  referencia_id bigint [not null]
  servicio_institucional_id int [not null]
  descripcion_snapshot nvarchar [not null]
  tipo_cliente_snapshot nvarchar
  periodo_institucional_id nvarchar
  indexes {
    (referencia_id, servicio_institucional_id) [unique]
  }
}

Table referencia_salida {
  referencia_salida_id bigint [pk, increment]
  referencia_id bigint [not null]
  tipo_salida nvarchar [not null]
  actor_id nvarchar [not null]
  generada_en datetime2 [not null]
}

Table consecutivo_referencia {
  establecimiento_id int [pk, note: 'Identificador institucional, sin FK']
  anio int [pk]
  ultimo_valor int [not null]
}

Table vinculo_deteccion_referencia {
  vinculo_deteccion_id bigint [pk, increment]
  referencia_id bigint [not null, unique]
  sistema_fuente nvarchar [not null]
  clave_resultado nvarchar [not null]
  criterio_codigo nvarchar [not null]
  criterio_version nvarchar [not null]
  fecha_o_periodo_observado nvarchar
  persona_institucional_id nvarchar [not null]
  establecimiento_id int [not null]
  indexes {
    (sistema_fuente, clave_resultado) [unique]
  }
}

Table sesion_interdisciplinaria {
  sesion_id bigint [pk, increment]
  oficina_local_id int [not null]
  fecha_sesion date [not null]
  hora_inicio time [not null]
  hora_fin time
  lugar nvarchar
  estado nvarchar [not null, note: 'REGISTRADA. Otros estados: NEEDS_VALIDATION']
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  version_fila rowversion
  indexes {
    (oficina_local_id, fecha_sesion)
  }
}

Table sesion_disciplina {
  sesion_disciplina_id bigint [pk, increment]
  sesion_id bigint [not null]
  item_id bigint [not null]
  etiqueta_snapshot nvarchar [not null]
  indexes {
    (sesion_id, item_id) [unique]
  }
}

Table sesion_asunto {
  sesion_asunto_id bigint [pk, increment]
  sesion_id bigint [not null]
  referencia_id bigint
  caso_id bigint
  agregada_en datetime2 [not null]
  agregada_por nvarchar [not null]
  indexes {
    (sesion_id, referencia_id)
    (sesion_id, caso_id)
  }
}

Table valoracion_situacional {
  valoracion_id bigint [pk, increment]
  sesion_id bigint [not null]
  version_instrumento_id bigint [not null]
  referencia_id bigint
  caso_id bigint
  resumen nvarchar
  riesgo_nivel_id bigint [not null]
  proteccion_nivel_id bigint [not null]
  confirmada_por nvarchar [not null]
  confirmada_en datetime2 [not null]
  indexes {
    (sesion_id, referencia_id)
    (caso_id, confirmada_en)
  }
}

Table valoracion_categoria_respuesta {
  valoracion_categoria_id bigint [pk, increment]
  valoracion_id bigint [not null]
  categoria_id bigint [not null]
  respuesta nvarchar [not null, note: 'FACTORES o NINGUNO. La ausencia de fila significa pendiente.']
  indexes {
    (valoracion_id, categoria_id) [unique]
  }
}

Table valoracion_factor {
  valoracion_factor_id bigint [pk, increment]
  valoracion_id bigint [not null]
  factor_id bigint [not null]
  etiqueta_snapshot nvarchar [not null]
  especificacion nvarchar
  indexes {
    (valoracion_id, factor_id) [unique]
  }
}

Table resolucion_ai {
  resolucion_id bigint [pk, increment]
  referencia_id bigint [not null, unique]
  sesion_id bigint [not null]
  valoracion_id bigint [not null, unique]
  decision nvarchar [not null, note: 'REQUIERE_AI o NO_REQUIERE_AI']
  justificacion nvarchar
  decidida_por nvarchar [not null]
  decidida_en datetime2 [not null]
}

Table caso_ai {
  caso_id bigint [pk, increment]
  persona_institucional_id nvarchar [not null, note: 'Sin FK a SIDINACC']
  referencia_origen_id bigint
  resolucion_id bigint
  sesion_apertura_id bigint
  caso_predecesor_id bigint
  decision_vigente_id bigint
  plan_vigente_id bigint
  lote_migracion_id bigint
  base_apertura nvarchar [not null, note: 'ADMISION, CONTINUIDAD_TRASLADO, MIGRACION']
  region_id int [not null]
  oficina_local_id int [not null]
  establecimiento_id int [not null]
  estado nvarchar [not null, note: 'ACTIVO, CERRADO, CERRADO_POR_TRASLADO']
  fecha_apertura date [not null]
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  version_fila rowversion
  indexes {
    (oficina_local_id, estado)
    (establecimiento_id, estado)
    (persona_institucional_id, fecha_apertura)
    (referencia_origen_id)
  }
  Note: 'Indice filtrado unico de SQL Server: como maximo un caso con base_apertura ADMISION por referencia_origen_id. DBML no expresa el filtro.'
}

Table caso_decision_profesional {
  decision_id bigint [pk, increment]
  caso_id bigint [not null]
  valoracion_id bigint
  decision_origen_id bigint
  riesgo_nivel_id bigint [not null]
  proteccion_nivel_id bigint [not null]
  prioridad_nivel_id bigint [not null]
  version_matriz_id bigint [not null]
  vigente_desde datetime2 [not null]
  registrada_por nvarchar [not null]
  motivo_cambio nvarchar
  indexes {
    (caso_id, vigente_desde)
  }
}

Table caso_estado_evento {
  caso_estado_evento_id bigint [pk, increment]
  caso_id bigint [not null]
  motivo_item_id bigint
  tipo_evento nvarchar [not null, note: 'ABIERTO, CERRADO, CERRADO_POR_TRASLADO']
  fecha_hecho date [not null]
  detalle nvarchar
  registrada_por nvarchar [not null]
  registrado_en datetime2 [not null]
  indexes {
    (caso_id, fecha_hecho)
  }
}

Table plan_atencion_version {
  plan_version_id bigint [pk, increment]
  caso_id bigint [not null]
  frecuencia_item_id bigint [not null]
  plan_origen_id bigint
  numero_version int [not null]
  vigente_desde datetime2 [not null]
  registrada_por nvarchar [not null]
  indexes {
    (caso_id, numero_version) [unique]
  }
}

Table plan_proposito {
  plan_proposito_id bigint [pk, increment]
  plan_version_id bigint [not null]
  texto nvarchar [not null]
  orden int [not null]
}

Table plan_estrategia {
  plan_estrategia_id bigint [pk, increment]
  plan_version_id bigint [not null]
  item_id bigint [not null]
  etiqueta_snapshot nvarchar [not null]
  indexes {
    (plan_version_id, item_id) [unique]
  }
}

Table plan_disciplina {
  plan_disciplina_id bigint [pk, increment]
  plan_version_id bigint [not null]
  item_id bigint [not null]
  etiqueta_snapshot nvarchar [not null]
  indexes {
    (plan_version_id, item_id) [unique]
  }
}

Table atencion_individual {
  atencion_individual_id bigint [pk, increment]
  caso_id bigint [not null]
  disciplina_item_id bigint [not null]
  estrategia_item_id bigint [not null]
  lote_migracion_id bigint
  oficina_local_id int [not null]
  fecha_atencion date [not null]
  acciones nvarchar
  recomendaciones nvarchar
  proxima_accion nvarchar
  fecha_proxima_accion date
  responsable_actor_id nvarchar [not null]
  responsable_nombre_snapshot nvarchar [not null]
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  indexes {
    (caso_id, fecha_atencion)
    (oficina_local_id, fecha_atencion)
    (responsable_actor_id, fecha_atencion)
  }
}

Table atencion_grupal {
  atencion_grupal_id bigint [pk, increment]
  tipo_item_id bigint [not null]
  lote_migracion_id bigint
  oficina_local_id int [not null]
  establecimiento_id int
  fecha_atencion date [not null]
  tema_objetivo nvarchar [not null]
  lugar nvarchar
  acciones nvarchar
  recomendaciones nvarchar
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  indexes {
    (oficina_local_id, fecha_atencion)
    (establecimiento_id, fecha_atencion)
  }
}

Table atencion_grupal_disciplina {
  atencion_grupal_disciplina_id bigint [pk, increment]
  atencion_grupal_id bigint [not null]
  item_id bigint [not null]
  etiqueta_snapshot nvarchar [not null]
  indexes {
    (atencion_grupal_id, item_id) [unique]
  }
}

Table atencion_grupal_profesional {
  atencion_grupal_profesional_id bigint [pk, increment]
  atencion_grupal_id bigint [not null]
  actor_id nvarchar [not null]
  nombre_snapshot nvarchar [not null]
  indexes {
    (atencion_grupal_id, actor_id) [unique]
  }
}

Table atencion_grupal_participante {
  participante_id bigint [pk, increment]
  atencion_grupal_id bigint [not null]
  caso_id bigint
  persona_institucional_id nvarchar [not null]
  asistio bit [not null]
  indexes {
    (atencion_grupal_id, persona_institucional_id) [unique]
    (caso_id, asistio)
    (persona_institucional_id, asistio)
  }
}

Table caso_documento {
  caso_documento_id bigint [pk, increment]
  caso_id bigint [not null]
  tipo_item_id bigint [not null]
  fecha_documento date [not null]
  responsable_actor_id nvarchar [not null]
  responsable_nombre_snapshot nvarchar [not null]
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  localizador_archivo nvarchar [not null]
  nombre_archivo nvarchar [not null]
  indexes {
    (caso_id, fecha_documento)
  }
}

Table coordinacion_interinstitucional {
  coordinacion_id bigint [pk, increment]
  caso_id bigint [not null]
  institucion_item_id bigint
  institucion_nombre nvarchar
  profesional_responsable nvarchar [not null]
  motivo nvarchar [not null]
  fecha_coordinacion date [not null]
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  version_fila rowversion
  indexes {
    (caso_id, fecha_coordinacion)
  }
}

Table coordinacion_estado_evento {
  coordinacion_estado_evento_id bigint [pk, increment]
  coordinacion_id bigint [not null]
  estado_item_id bigint [not null]
  etiqueta_snapshot nvarchar [not null]
  vigente_desde datetime2 [not null]
  registrada_por nvarchar [not null]
  indexes {
    (coordinacion_id, vigente_desde)
  }
}

Table caso_reporte {
  caso_reporte_id bigint [pk, increment]
  caso_id bigint [not null]
  tipo_item_id bigint [not null]
  motivo nvarchar [not null]
  fecha_reporte date [not null]
  responsable_actor_id nvarchar [not null]
  responsable_nombre_snapshot nvarchar [not null]
  registrada_por nvarchar [not null]
  registrado_en datetime2 [not null]
  indexes {
    (caso_id, fecha_reporte)
  }
}

Table caso_traslado {
  traslado_id bigint [pk, increment]
  caso_origen_id bigint [not null, unique]
  caso_destino_id bigint
  motivo_item_id bigint [not null]
  region_destino_id int [not null]
  region_destino_nombre_snapshot nvarchar [not null]
  oficina_destino_id int [not null]
  oficina_destino_nombre_snapshot nvarchar [not null]
  establecimiento_destino_id int [not null]
  establecimiento_destino_nombre_snapshot nvarchar [not null]
  region_origen_id int [not null]
  region_origen_nombre_snapshot nvarchar [not null]
  oficina_origen_id int [not null]
  oficina_origen_nombre_snapshot nvarchar [not null]
  fecha_traslado date [not null]
  detalle nvarchar
  estado nvarchar [not null, note: 'PENDIENTE_CONTINUIDAD o CONTINUIDAD_CONFIRMADA']
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  confirmada_por nvarchar
  confirmada_en datetime2
  indexes {
    (oficina_destino_id, estado)
    (caso_destino_id)
  }
}

Table actividad_programada {
  actividad_id bigint [pk, increment]
  tipo_item_id bigint [not null]
  oficina_local_id int [not null]
  establecimiento_id int
  fecha_prevista date [not null]
  titulo_proposito nvarchar [not null]
  observaciones nvarchar
  estado nvarchar [not null, note: 'PROGRAMADA, REALIZADA, REPROGRAMADA, CANCELADA']
  motivo_vigente nvarchar
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  version_fila rowversion
  indexes {
    (oficina_local_id, estado, fecha_prevista)
    (establecimiento_id, estado)
  }
}

Table actividad_programada_sujeto {
  actividad_sujeto_id bigint [pk, increment]
  actividad_id bigint [not null]
  caso_id bigint
  persona_institucional_id nvarchar
  indexes {
    (actividad_id, caso_id)
    (actividad_id, persona_institucional_id)
  }
}

Table actividad_programada_transicion {
  actividad_transicion_id bigint [pk, increment]
  actividad_id bigint [not null]
  motivo_item_id bigint
  estado_anterior nvarchar [not null]
  estado_nuevo nvarchar [not null]
  fecha_anterior date
  fecha_nueva date
  motivo_texto nvarchar
  registrada_por nvarchar [not null]
  registrada_en datetime2 [not null]
  indexes {
    (actividad_id, registrada_en)
    (estado_nuevo, registrada_en)
  }
}

Table conjunto_catalogo {
  conjunto_id bigint [pk, increment]
  tipo_catalogo nvarchar [not null]
  etiqueta_version nvarchar [not null]
  publicado_en datetime2 [not null]
  publicada_por nvarchar [not null]
  es_vigente bit [not null]
  indexes {
    (tipo_catalogo, es_vigente)
  }
}

Table item_catalogo {
  item_id bigint [pk, increment]
  item_padre_id bigint
  tipo_catalogo nvarchar [not null]
  codigo nvarchar [not null]
  etiqueta nvarchar [not null]
  orden int [not null]
  activo bit [not null]
  permite_texto_libre bit [not null]
  ambito_codigo nvarchar
  indexes {
    (tipo_catalogo, codigo) [unique]
  }
}

Table conjunto_catalogo_item {
  conjunto_id bigint [pk]
  item_id bigint [pk]
  orden int [not null]
}

Table version_instrumento {
  version_instrumento_id bigint [pk, increment]
  etiqueta nvarchar [not null]
  publicada_en datetime2 [not null]
  publicada_por nvarchar [not null]
  es_vigente bit [not null]
}

Table categoria_instrumento {
  categoria_id bigint [pk, increment]
  version_instrumento_id bigint [not null]
  ambito nvarchar [not null, note: 'INDIVIDUAL, HOGAR_FAMILIAR, COMUNITARIO']
  clase_factor nvarchar [not null, note: 'PROTECTOR, RIESGO, SIGNO_ALERTA']
  nombre nvarchar [not null]
  es_requerida bit [not null]
  orden int [not null]
  indexes {
    (version_instrumento_id, ambito, clase_factor) [unique]
  }
}

Table factor_instrumento {
  factor_id bigint [pk, increment]
  categoria_id bigint [not null]
  codigo nvarchar [not null]
  etiqueta nvarchar [not null]
  orden int [not null]
  activo bit [not null]
  permite_texto_libre bit [not null]
  indexes {
    (categoria_id, codigo) [unique]
  }
}

Table nivel_escala {
  nivel_id bigint [pk, increment]
  tipo_escala nvarchar [not null, note: 'RIESGO, PROTECCION, PRIORIDAD']
  codigo nvarchar [not null]
  etiqueta nvarchar [not null]
  orden int [not null]
  activo bit [not null]
  indexes {
    (tipo_escala, codigo) [unique]
  }
}

Table version_matriz_prioridad {
  version_matriz_id bigint [pk, increment]
  etiqueta nvarchar [not null]
  publicada_en datetime2 [not null]
  publicada_por nvarchar [not null]
  es_vigente bit [not null]
}

Table celda_matriz_prioridad {
  celda_id bigint [pk, increment]
  version_matriz_id bigint [not null]
  riesgo_nivel_id bigint [not null]
  proteccion_nivel_id bigint [not null]
  prioridad_nivel_id bigint [not null]
  indexes {
    (version_matriz_id, riesgo_nivel_id, proteccion_nivel_id) [unique]
  }
}

Table conjunto_rango_edad {
  conjunto_rango_id bigint [pk, increment]
  nombre nvarchar [not null]
  es_vigente bit [not null]
}

Table rango_edad {
  rango_edad_id bigint [pk, increment]
  conjunto_rango_id bigint [not null]
  etiqueta nvarchar [not null]
  edad_minima_inclusiva int [not null]
  edad_maxima_inclusiva int [not null]
  orden int [not null]
}

Table borrador_captura {
  borrador_id bigint [pk, increment]
  tipo_borrador nvarchar [not null]
  actor_id nvarchar [not null]
  oficina_local_id int
  sesion_id bigint
  referencia_id bigint
  caso_id bigint
  carga nvarchar [not null, note: 'Formulario incompleto. No es un hecho clinico.']
  actualizado_en datetime2 [not null]
  version_fila rowversion
  indexes {
    (actor_id, tipo_borrador)
  }
}

Table lote_migracion {
  lote_id bigint [pk, increment]
  fuente nvarchar [not null]
  estado nvarchar [not null]
  iniciado_por nvarchar [not null]
  iniciado_en datetime2 [not null]
  confirmado_en datetime2
}

Table incidencia_migracion {
  incidencia_id bigint [pk, increment]
  lote_id bigint [not null]
  referencia_fila_fuente nvarchar [not null]
  severidad nvarchar [not null]
  mensaje nvarchar [not null]
  registrada_en datetime2 [not null]
}

Ref: referencia.via_atencion_item_id > item_catalogo.item_id
Ref: referencia.origen_item_id > item_catalogo.item_id
Ref: referencia.lote_migracion_id > lote_migracion.lote_id
Ref: referencia_motivo.referencia_id > referencia.referencia_id
Ref: referencia_motivo.item_id > item_catalogo.item_id
Ref: referencia_servicio_snapshot.referencia_id > referencia.referencia_id
Ref: referencia_salida.referencia_id > referencia.referencia_id
Ref: vinculo_deteccion_referencia.referencia_id > referencia.referencia_id

Ref: sesion_disciplina.sesion_id > sesion_interdisciplinaria.sesion_id
Ref: sesion_disciplina.item_id > item_catalogo.item_id
Ref: sesion_asunto.sesion_id > sesion_interdisciplinaria.sesion_id
Ref: sesion_asunto.referencia_id > referencia.referencia_id
Ref: sesion_asunto.caso_id > caso_ai.caso_id

Ref: valoracion_situacional.sesion_id > sesion_interdisciplinaria.sesion_id
Ref: valoracion_situacional.version_instrumento_id > version_instrumento.version_instrumento_id
Ref: valoracion_situacional.referencia_id > referencia.referencia_id
Ref: valoracion_situacional.caso_id > caso_ai.caso_id
Ref: valoracion_situacional.riesgo_nivel_id > nivel_escala.nivel_id
Ref: valoracion_situacional.proteccion_nivel_id > nivel_escala.nivel_id
Ref: valoracion_categoria_respuesta.valoracion_id > valoracion_situacional.valoracion_id
