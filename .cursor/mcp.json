{
  "mcpServers": {
    "sia-chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--ignore-scripts",
        "chrome-devtools-mcp@1.13.0",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": { "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1" }
    },
    "sia-playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--ignore-scripts",
        "@playwright/mcp@0.0.86",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--caps",
        "vision"
      ]
    }
  }
}
