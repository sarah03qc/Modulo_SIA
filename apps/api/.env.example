# Copiar a apps/api/.env y completar en local. No versionar apps/api/.env.
# El arranque rechaza el valor de ejemplo CHANGE_ME.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://127.0.0.1:5174

DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000
DB_POOL_MAX=5

SIA_DB_SERVER=127.0.0.1
SIA_DB_PORT=1433
SIA_DB_NAME=SIA_CENCINAI
SIA_DB_USER=CHANGE_ME
SIA_DB_PASSWORD=CHANGE_ME
SIA_DB_ENCRYPT=false
SIA_DB_TRUST_SERVER_CERTIFICATE=true

# Login local de solo lectura, distinto del usuario de SIA_CENCINAI.
# La contraseña se genera en el entorno y no se versiona.
# El login se mapea solo en SIDINACC_LOCAL, como miembro de sia_sidinacc_reader_role.
SIDINACC_DB_SERVER=127.0.0.1
SIDINACC_DB_PORT=1433
SIDINACC_DB_NAME=SIDINACC_LOCAL
SIDINACC_DB_USER=sia_sidinacc_app
SIDINACC_DB_PASSWORD=CHANGE_ME
SIDINACC_DB_ENCRYPT=false
SIDINACC_DB_TRUST_SERVER_CERTIFICATE=true
