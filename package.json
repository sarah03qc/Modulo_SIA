{
  "name": "sia-cencinai",
  "version": "0.1.0",
  "private": true,
  "description": "SIA-CENCINAI: apoyo a la Atención Interdisciplinaria de CEN-CINAI.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev-environment.js start",
    "dev:api": "npm run dev -w @sia/api",
    "dev:web": "npm run dev -w @sia/web",
    "start:api": "npm run start -w @sia/api",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build -w @sia/web",
    "verify:config": "npm run verify:config -w @sia/api",
    "health": "node scripts/check-health.js",
    "check:runtime": "node scripts/verify-runtime.js",
    "stop": "node scripts/dev-environment.js stop"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.2",
    "supertest": "7.3.1",
    "vite": "8.3.6"
  }
}
